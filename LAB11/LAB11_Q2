#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INF 1e9

typedef struct Node {
    int vertex;
    struct Node* next;
} Node;

typedef struct Graph {
    int numVertices;
    Node** adjLists;
} Graph;

Node* createNode(int v) {
    Node* newNode = malloc(sizeof(Node));
    newNode->vertex = v;
    newNode->next = NULL;
    return newNode;
}

Graph* createGraph(int vertices) {
    Graph* graph = malloc(sizeof(Graph));
    graph->numVertices = vertices;
    graph->adjLists = malloc((vertices + 1) * sizeof(Node*));
    for (int i = 0; i <= vertices; i++) {
        graph->adjLists[i] = NULL;
    }
    return graph;
}

void addEdge(Graph* graph, int src, int dest) {
    Node* newNode = createNode(dest);
    newNode->next = graph->adjLists[src];
    graph->adjLists[src] = newNode;

    newNode = createNode(src);
    newNode->next = graph->adjLists[dest];
    graph->adjLists[dest] = newNode;
}

void computeVoronoiCells(Graph* graph, int* hubs, int K, int R) {
    int V = graph->numVertices;
    
    int* owner = malloc((V + 1) * sizeof(int));
    int* dist = malloc((V + 1) * sizeof(int));
    
    for (int i = 1; i <= V; i++) {
        owner[i] = -1;
        dist[i] = INF;
    }

        int* queue = malloc((V + 1) * sizeof(int));
    int front = 0, rear = 0;

    for (int i = 0; i < K; i++) {
        int h = hubs[i];
        int hubIdx = i + 1;
        
        
        if (dist[h] == INF) {
            dist[h] = 0;
            owner[h] = hubIdx;
            queue[rear++] = h;
        }
    }

    
    while (front < rear) {
        int u = queue[front++];
        
       
        if (dist[u] >= R) {
            continue;
        }

        Node* temp = graph->adjLists[u];
        while (temp != NULL) {
            int v = temp->vertex;
            
            
            if (dist[v] == INF) {
                dist[v] = dist[u] + 1;
                owner[v] = owner[u];
                queue[rear++] = v;
            } 
           
            else if (dist[v] == dist[u] + 1) {
                if (owner[u] < owner[v]) {
                    owner[v] = owner[u]; 
                }
            }
            temp = temp->next;
        }
    }

    printf("\n--- Voronoi Cell Partitioning (Radius R = %d) ---\n", R);
    printf("Vertex\tOwner Hub\tDistance\n");
    for (int i = 1; i <= V; i++) {
        if (owner[i] == -1) {
            printf("%d\t-1 (None)\tINF\n", i);
        } else {
            printf("%d\tHub %d\t\t%d\n", i, owner[i], dist[i]);
        }
    }

    free(owner);
    free(dist);
    free(queue);
}

int main() {
    int vertices = 7;
    Graph* graph = createGraph(vertices);

    addEdge(graph, 1, 2);
    addEdge(graph, 1, 3);
    addEdge(graph, 2, 4);
    addEdge(graph, 3, 4);
    addEdge(graph, 4, 5);
    addEdge(graph, 5, 6);
    addEdge(graph, 6, 7);

   
    int hubs[] = {1, 5};
    int K = sizeof(hubs) / sizeof(hubs[0]);
    int radiusR = 2;

    computeVoronoiCells(graph, hubs, K, radiusR);

    return 0;
}
