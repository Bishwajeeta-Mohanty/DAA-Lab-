#include <stdio.h>
#include <stdlib.h>

#define MAX 20

int switches[MAX];
int n;


void display()
{
    int i;

    for (i = 0; i < n; i++)
    {
        if (switches[i] == 1)
            printf("ON ");
        else
            printf("OFF ");
    }

    printf("\n");
}


int canToggle(int pos)
{
    int i;

    
    if (pos == n - 1)
        return 1;

   
    if (switches[pos + 1] == 0)
        return 0;

    
    for (i = pos + 2; i < n; i++)
    {
        if (switches[i] == 1)
            return 0;
    }

    return 1;
}

void toggle(int pos)
{
    switches[pos] = 1 - switches[pos];
}


void solve(int k)
{
    int i;

    if (k == 1)
    {
        toggle(0);

        printf("Toggle switch 1\n");
        display();

        return;
    }

   

    if (k == 2)
    {
        toggle(0);
        printf("Toggle switch 1\n");
        display();

        toggle(1);
        printf("Toggle switch 2\n");
        display();

        return;
    }

    
    toggle(k - 1);
    printf("Toggle switch %d\n", k);
    display();

    
    for (i = k - 3; i >= 0; i--)
    {
        if (canToggle(i))
        {
            
            solve(i + 1);

            break;
        }
    }

    
    toggle(k - 1);
    printf("Toggle switch %d\n", k);
    display();
}

int main()
{
    int i;
    unsigned long long power = 1;
    unsigned long long minMoves;

    printf("Enter number of security switches: ");
    scanf("%d", &n);

    if (n <= 0 || n >= MAX)
    {
        printf("Invalid number of switches.\n");
        return 0;
    }

    /* Initially all switches are ON */
    for (i = 0; i < n; i++)
        switches[i] = 1;

   
    for (i = 0; i < n + 1; i++)
        power *= 2;

    minMoves = power / 3;

    printf("\nInitial state:\n");
    display();

    printf("\nMinimum number of moves = %llu\n",
           minMoves);

    printf("\nSequence of operations:\n");

    

    if (n <= 5)
    {
       

        unsigned long long states = 1ULL << n;

        int *distance = malloc(states * sizeof(int));
        int *parent = malloc(states * sizeof(int));
        int *move = malloc(states * sizeof(int));
        int *queue = malloc(states * sizeof(int));

        int front = 0, rear = 0;

        unsigned long long start = states - 1;
        unsigned long long goal = 0;

        for (i = 0; i < states; i++)
        {
            distance[i] = -1;
            parent[i] = -1;
            move[i] = -1;
        }

        queue[rear++] = start;
        distance[start] = 0;

        while (front < rear)
        {
            unsigned long long state = queue[front++];

            if (state == goal)
                break;

            for (i = 0; i < n; i++)
            {
                int legal = 0;

                
                if (i == n - 1)
                {
                    legal = 1;
                }
                else
                {
                   
                    if ((state & (1ULL << (n - 1 - (i + 1)))) != 0)
                    {
                        legal = 1;

                        
                        int j;

                        for (j = i + 2; j < n; j++)
                        {
                            if (state &
                                (1ULL << (n - 1 - j)))
                            {
                                legal = 0;
                                break;
                            }
                        }
                    }
                }

                if (legal)
                {
                    unsigned long long newState;

                    newState =
                        state ^ (1ULL << (n - 1 - i));

                    if (distance[newState] == -1)
                    {
                        distance[newState] =
                            distance[state] + 1;

                        parent[newState] = state;
                        move[newState] = i;

                        queue[rear++] = newState;
                    }
                }
            }
        }

       
        int length = distance[goal];

        int *moves = malloc(length * sizeof(int));

        unsigned long long state = goal;

        for (i = length - 1; i >= 0; i--)
        {
            moves[i] = move[state];
            state = parent[state];
        }

        
        for (i = 0; i < n; i++)
            switches[i] = 1;

        printf("\n");

        for (i = 0; i < length; i++)
        {
            int pos = moves[i];

            toggle(pos);

            printf("Move %d: Toggle switch %d -> ",
                   i + 1, pos + 1);

            display();
        }

        printf("\nTotal moves performed = %d\n",
               length);

        free(distance);
        free(parent);
        free(move);
        free(queue);
        free(moves);
    }
    else
    {
        printf("\nFor n > 5, the minimum number of moves is "
               "%llu.\n", minMoves);

        printf("The state-space representation is limited "
               "to small n for displaying every move.\n");
    }

    return 0;
}
