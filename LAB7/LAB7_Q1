#include <stdio.h>

int main()
{
    int n;
    long long totalCoins, minMoves;

    printf("Enter number of rows: ");
    scanf("%d", &n);

    totalCoins = (long long)n * (n + 1) / 2;

    minMoves = totalCoins / 3;

    printf("Total number of coins = %lld\n", totalCoins);
    printf("Minimum number of moves = %lld\n", minMoves);

    return 0;
}
