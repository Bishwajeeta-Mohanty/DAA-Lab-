#include <stdio.h>
#include <limits.h>

#define MAX_EGGS 10
#define MAX_FLOORS 100

int max(int a, int b)
{
    return (a > b) ? a : b;
}

int main()
{
    int E, F;
    int dp[MAX_EGGS + 1][MAX_FLOORS + 1];

    printf("Enter number of eggs: ");
    scanf("%d", &E);

    printf("Enter number of floors: ");
    scanf("%d", &F);

    for (int e = 1; e <= E; e++)
    {
        dp[e][0] = 0;
        dp[e][1] = 1;
    }

    for (int f = 1; f <= F; f++)
    {
        dp[1][f] = f;
    }

    for (int e = 2; e <= E; e++)
    {
        for (int f = 2; f <= F; f++)
        {
            dp[e][f] = INT_MAX;

            for (int x = 1; x <= f; x++)
            {
                int worstCase;

                worstCase = 1 + max(
                    dp[e - 1][x - 1],
                    dp[e][f - x]
                );

                if (worstCase < dp[e][f])
                {
                    dp[e][f] = worstCase;
                }
            }
        }
    }

    printf("\nMinimum number of drops required = %d\n",
           dp[E][F]);

    return 0;
}
