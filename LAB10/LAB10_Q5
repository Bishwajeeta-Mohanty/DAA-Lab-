
#include <stdio.h>
#include <stdlib.h>

#define MAX 100005

int parent[MAX], size[MAX];
typedef struct
{
    int root;
    int key;
} Item;

int find(int x)
{
    if (parent[x] != x)
        parent[x] = find(parent[x]);

    return parent[x];
}

void unite(int u, int v)
{
    int a = find(u);
    int b = find(v);

    if (a == b)
        return;

    if (size[a] < size[b])
    {
        int temp = a;
        a = b;
        b = temp;
    }

    parent[b] = a;
    size[a] += size[b];
}

int compare(const void *a, const void *b)
{
    Item *x = (Item *)a;
    Item *y = (Item *)b;

    if (x->root != y->root)
        return (x->root > y->root) -
               (x->root < y->root);

    return (x->key > y->key) -
           (x->key < y->key);
}

int main()
{
    int n, m;
    int A[MAX];

    Item positions[MAX], values[MAX];

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n >= MAX)
    {
        printf("Invalid number of elements.\n");
        return 1;
    }

    printf("Enter the permutation:\n");

    int seen[MAX] = {0};

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &A[i]);

        if (A[i] < 1 || A[i] > n || seen[A[i]])
        {
            printf("Invalid permutation.\n");
            return 1;
        }

        seen[A[i]] = 1;
    }

    printf("Enter number of allowable swaps: ");
    scanf("%d", &m);

    if (m < 0)
    {
        printf("Invalid number of swaps.\n");
        return 1;
    }
    for (int i = 0; i < n; i++)
    {
        parent[i] = i;
        size[i] = 1;
    }
    printf("Enter allowable pairs (u v):\n");

    for (int i = 0; i < m; i++)
    {
        int u, v;
        scanf("%d %d", &u, &v);

        if (u < 1 || u > n || v < 1 || v > n)
        {
            printf("Invalid pair.\n");
            return 1;
        }

        unite(u - 1, v - 1);
    }

    for (int i = 0; i < n; i++)
    {
        int root = find(i);

        positions[i].root = root;
        positions[i].key = i;

        values[i].root = root;
        values[i].key = A[i];
    }
    qsort(positions, n, sizeof(Item), compare);
    qsort(values, n, sizeof(Item), compare);

    for (int i = 0; i < n; i++)
    {
        int pos = positions[i].key;
        A[pos] = values[i].key;
    }

    printf("\nLexicographically smallest permutation:\n");

    for (int i = 0; i < n; i++)
        printf("%d ", A[i]);

    printf("\n");

    return 0;
}
