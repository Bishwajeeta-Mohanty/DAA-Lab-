
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 100005
#define CHARSET 256

typedef struct
{
    unsigned char ch;
    int freq;
    int ready;
} Node;

Node heap[MAX];
Node waiting[MAX];

int heapSize = 0;
int front = 0, rear = 0;

void swap(Node *a, Node *b)
{
    Node temp = *a;
    *a = *b;
    *b = temp;
}

void insert(Node x)
{
    int i = ++heapSize;

    heap[i] = x;

    while (i > 1 && heap[i].freq > heap[i / 2].freq)
    {
        swap(&heap[i], &heap[i / 2]);
        i = i / 2;
    }
}

Node deleteMax()
{
    Node result = heap[1];

    heap[1] = heap[heapSize--];

    int i = 1;

    while (2 * i <= heapSize)
    {
        int child = 2 * i;

        if (child + 1 <= heapSize &&
            heap[child + 1].freq > heap[child].freq)
        {
            child++;
        }

        if (heap[i].freq >= heap[child].freq)
            break;

        swap(&heap[i], &heap[child]);
        i = child;
    }

    return result;
}

void reorganize(char S[], int K)
{
    int n = strlen(S);
    int count[CHARSET] = {0};

    char result[MAX];
    int index = 0;

    heapSize = 0;
    front = rear = 0;

    for (int i = 0; i < n; i++)
        count[(unsigned char)S[i]]++;

    for (int i = 0; i < CHARSET; i++)
    {
        if (count[i] > 0)
        {
            Node x;

            x.ch = (unsigned char)i;
            x.freq = count[i];
            x.ready = 0;

            insert(x);
        }
    }

    for (int pos = 0; pos < n; pos++)
    {
        while (front < rear &&
               waiting[front].ready <= pos)
        {
            insert(waiting[front]);
            front++;
        }

        if (heapSize == 0)
        {
            printf("Reorganized string: \"\"\n");
            return;
        }

        Node x = deleteMax();

        result[index++] = x.ch;

        x.freq--;

        if (x.freq > 0)
        {
            x.ready = pos + K;
            waiting[rear++] = x;
        }
    }

    result[index] = '\0';

    printf("Reorganized string: %s\n", result);
}

int main()
{
    char S[MAX];
    int K;

    printf("Enter the string: ");
    scanf("%100004s", S);

    printf("Enter the value of K: ");
    scanf("%d", &K);

    if (K < 0)
    {
        printf("Invalid value of K.\n");
        return 1;
    }

    reorganize(S, K);

    return 0;
}
