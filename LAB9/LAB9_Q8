
#include <stdio.h>
#include <stdlib.h>

#define MAX 100005


typedef struct
{
    int start;
    int end;
} Meeting;

int heap[MAX];
int heapSize = 0;


void swap(int *a, int *b)
{
    int temp = *a;
    *a = *b;
    *b = temp;
}

void insert(int value)
{
    int i = ++heapSize;

    heap[i] = value;

    while (i > 1 && heap[i] < heap[i / 2])
    {
        swap(&heap[i], &heap[i / 2]);
        i = i / 2;
    }
}
int getMin()
{
    return heap[1];
}
void deleteMin()
{
    heap[1] = heap[heapSize--];

    int i = 1;

    while (2 * i <= heapSize)
    {
        int child = 2 * i;

        if (child + 1 <= heapSize &&
            heap[child + 1] < heap[child])
        {
            child++;
        }

        if (heap[i] <= heap[child])
            break;

        swap(&heap[i], &heap[child]);
        i = child;
    }
}

int compare(const void *a, const void *b)
{
    Meeting *m1 = (Meeting *)a;
    Meeting *m2 = (Meeting *)b;

    if (m1->start < m2->start)
        return -1;

    if (m1->start > m2->start)
        return 1;

    return 0;
}
int minMeetingRooms(Meeting meetings[], int n)
{
    if (n == 0)
        return 0;

    heapSize = 0;

    qsort(meetings, n, sizeof(Meeting), compare);

    int maxRooms = 0;

    for (int i = 0; i < n; i++)
    {
        while (heapSize > 0 &&
               getMin() <= meetings[i].start)
        {
            deleteMin();
        }
        insert(meetings[i].end);
        if (heapSize > maxRooms)
            maxRooms = heapSize;
    }

    return maxRooms;
}

int main()
{
    int n;
    Meeting meetings[MAX];

    printf("Enter number of meetings: ");
    scanf("%d", &n);

    if (n < 0 || n >= MAX)
    {
        printf("Invalid number of meetings.\n");
        return 1;
    }

    printf("Enter start and end times:\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%d %d",
              &meetings[i].start,
              &meetings[i].end);

        if (meetings[i].start >= meetings[i].end)
        {
            printf("Invalid meeting interval.\n");
            return 1;
        }
    }

    int result = minMeetingRooms(meetings, n);

    printf("\nMinimum number of conference rooms = %d\n",
           result);

    return 0;
}
