
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define MAX 100005

long long heap[MAX];
int heapSize = 0;

void swap(long long *a, long long *b)
{
    long long temp = *a;
    *a = *b;
    *b = temp;
}

void insert(long long value)
{
    int i = ++heapSize;

    heap[i] = value;

    while (i > 1 && heap[i] > heap[i / 2])
    {
        swap(&heap[i], &heap[i / 2]);
        i = i / 2;
    }
}

long long getMax()
{
    return heap[1];
}

long long deleteMax()
{
    long long maximum = heap[1];

    heap[1] = heap[heapSize--];

    int i = 1;

    while (2 * i <= heapSize)
    {
        int child = 2 * i;

        if (child + 1 <= heapSize &&
            heap[child + 1] > heap[child])
        {
            child++;
        }

        if (heap[i] >= heap[child])
            break;

        swap(&heap[i], &heap[child]);

        i = child;
    }

    return maximum;
}
long long minimumDeviation(int A[], int n)
{
    long long minVal = LLONG_MAX;
    long long minDeviation;

    heapSize = 0;

    for (int i = 0; i < n; i++)
    {
        long long x = A[i];

        if (x % 2 != 0)
            x = x * 2;

        insert(x);

        if (x < minVal)
            minVal = x;
    }

    minDeviation = getMax() - minVal;

    while (getMax() % 2 == 0)
    {
        long long x = deleteMax();

        x = x / 2;

        if (x < minVal)
            minVal = x;

        insert(x);

        long long deviation = getMax() - minVal;

        if (deviation < minDeviation)
            minDeviation = deviation;
    }

    return minDeviation;
}

int main()
{
    int n;
    int A[MAX];

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n >= MAX)
    {
        printf("Invalid array size.\n");
        return 1;
    }

    printf("Enter array elements:\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &A[i]);

        if (A[i] <= 0)
        {
            printf("Elements must be positive.\n");
            return 1;
        }
    }

    long long result = minimumDeviation(A, n);

    printf("\nMinimum deviation = %lld\n", result);

    return 0;
}
