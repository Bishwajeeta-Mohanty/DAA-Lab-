#include <stdio.h>
#include <math.h>

#define MAX 20

void displayMatrix(double a[MAX][MAX], int n)
{
    int i, j;

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            printf("%8.2f ", a[i][j]);

        printf("\n");
    }
}

void addMatrix(double A[MAX][MAX],
               double B[MAX][MAX],
               double C[MAX][MAX],
               int n)
{
    int i, j;

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            C[i][j] = A[i][j] + B[i][j];
    }
}

void multiplyMatrix(double A[MAX][MAX],
                    double B[MAX][MAX],
                    double C[MAX][MAX],
                    int n)
{
    int i, j, k;

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            C[i][j] = 0;

            for (k = 0; k < n; k++)
                C[i][j] += A[i][k] * B[k][j];
        }
    }
}

int isZeroMatrix(double A[MAX][MAX], int n)
{
    int i, j;

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            if (A[i][j] != 0)
                return 0;
        }
    }

    return 1;
}

int isSymmetric(double A[MAX][MAX], int n)
{
    int i, j;

    for (i = 0; i < n; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (A[i][j] != A[j][i])
                return 0;
        }
    }

    return 1;
}

double determinant(double A[MAX][MAX], int n)
{
    double temp[MAX][MAX];
    double det = 1.0;
    double factor;
    int i, j, k, pivot;
    
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            temp[i][j] = A[i][j];
    }

    for (i = 0; i < n; i++)
    {
        pivot = i;

        for (j = i + 1; j < n; j++)
        {
            if (fabs(temp[j][i]) > fabs(temp[pivot][i]))
                pivot = j;
        }

        if (fabs(temp[pivot][i]) < 1e-10)
            return 0;

        if (pivot != i)
        {
            for (k = 0; k < n; k++)
            {
                double t = temp[i][k];
                temp[i][k] = temp[pivot][k];
                temp[pivot][k] = t;
            }

            det = -det;
        }

        det *= temp[i][i];

        for (j = i + 1; j < n; j++)
        {
            factor = temp[j][i] / temp[i][i];

            for (k = i; k < n; k++)
                temp[j][k] -= factor * temp[i][k];
        }
    }

    return det;
}

void transpose(double A[MAX][MAX],
                double T[MAX][MAX],
                int n)
{
    int i, j;

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            T[j][i] = A[i][j];
    }
}

/*
   Power Method:
   Finds dominant eigenvalue and corresponding eigenvector.
*/
void powerMethod(double A[MAX][MAX], int n)
{
    double x[MAX], y[MAX];
    double eigenvalue = 0;
    double newEigenvalue;
    double norm;
    int i, j, iteration;

    for (i = 0; i < n; i++)
        x[i] = 1.0;

    for (iteration = 0; iteration < 1000; iteration++)
    {
        /* y = A*x */
        for (i = 0; i < n; i++)
        {
            y[i] = 0;

            for (j = 0; j < n; j++)
                y[i] += A[i][j] * x[j];
        }

        norm = fabs(y[0]);

        for (i = 1; i < n; i++)
        {
            if (fabs(y[i]) > norm)
                norm = fabs(y[i]);
        }

        if (norm == 0)
        {
            printf("Power method failed.\n");
            return;
        }

        for (i = 0; i < n; i++)
            x[i] = y[i] / norm;

        newEigenvalue = norm;

        if (fabs(newEigenvalue - eigenvalue) < 1e-10)
            break;

        eigenvalue = newEigenvalue;
    }

    printf("Dominant Eigenvalue = %.6f\n", newEigenvalue);

    printf("Corresponding Eigenvector:\n");

    for (i = 0; i < n; i++)
        printf("%.6f\n", x[i]);
}

int main()
{
    double A[MAX][MAX], B[MAX][MAX];
    double C[MAX][MAX], T[MAX][MAX];

    int n, choice;
    int i, j;

    printf("Enter order of square matrix: ");
    scanf("%d", &n);

    printf("\nEnter Matrix A:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            scanf("%lf", &A[i][j]);
    }

    do
    {
        printf("\n========== MATRIX OPERATIONS ==========\n");
        printf("1. Matrix Addition\n");
        printf("2. Matrix Multiplication\n");
        printf("3. Check Zero Matrix\n");
        printf("4. Check Symmetric Matrix\n");
        printf("5. Find Determinant\n");
        printf("6. Find Transpose\n");
        printf("7. Find Eigenvalue and Eigenvector\n");
        printf("8. Display Matrix A\n");
        printf("0. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
        case 1:

            printf("\nEnter Matrix B:\n");

            for (i = 0; i < n; i++)
            {
                for (j = 0; j < n; j++)
                    scanf("%lf", &B[i][j]);
            }

            addMatrix(A, B, C, n);

            printf("\nA + B =\n");
            displayMatrix(C, n);

            break;

        case 2:

            printf("\nEnter Matrix B:\n");

            for (i = 0; i < n; i++)
            {
                for (j = 0; j < n; j++)
                    scanf("%lf", &B[i][j]);
            }

            multiplyMatrix(A, B, C, n);

            printf("\nA x B =\n");
            displayMatrix(C, n);

            break;

        case 3:

            if (isZeroMatrix(A, n))
                printf("Matrix A is a Zero Matrix.\n");
            else
                printf("Matrix A is NOT a Zero Matrix.\n");

            break;

        case 4:

            if (isSymmetric(A, n))
                printf("Matrix A is Symmetric.\n");
            else
                printf("Matrix A is NOT Symmetric.\n");

            break;

        case 5:

            printf("Determinant = %.4f\n",
                   determinant(A, n));

            break;

        case 6:

            transpose(A, T, n);

            printf("\nTranspose of A:\n");
            displayMatrix(T, n);

            break;

        case 7:

            powerMethod(A, n);

            break;

        case 8:

            printf("\nMatrix A:\n");
            displayMatrix(A, n);

            break;

        case 0:

            printf("Program terminated.\n");

            break;

        default:

            printf("Invalid choice.\n");
        }

    } while (choice != 0);

    return 0;
}
