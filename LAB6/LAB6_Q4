#include <stdio.h>

#define MAX 1000

void reverse(int a[], int left, int right)
{
    int temp;

    while (left < right)
    {
        temp = a[left];
        a[left] = a[right];
        a[right] = temp;

        left++;
        right--;
    }
}

void display(int a[], int n)
{
    int i;

    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\n");
}

void reversalSort(int a[], int n)
{
    int i, j;
    int reversals = 0;

    for (i = 0; i < n; i++)
    {
        
        for (j = i; j < n; j++)
        {
            if (a[j] == i + 1)
                break;
        }

        if (j != i)
        {
            reverse(a, i, j);
            reversals++;

            printf("After reversal %d: ", reversals);
            display(a, n);
        }
    }

    printf("\nTotal number of reversals = %d\n",
           reversals);
}

int main()
{
    int a[MAX];
    int n;
    int i;

    printf("Enter value of n: ");
    scanf("%d", &n);

    printf("Enter permutation of 1 to %d:\n", n);

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("\nOriginal permutation:\n");
    display(a, n);

    reversalSort(a, n);

    printf("\nSorted permutation:\n");
    display(a, n);

    return 0;
}
