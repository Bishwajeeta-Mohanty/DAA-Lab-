#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <complex.h>

#define PI acos(-1.0)

void fft(double complex a[], int n, int invert)
{
    int i, j, len;

    for (i = 1, j = 0; i < n; i++)
    {
        int bit = n >> 1;

        while (j & bit)
        {
            j ^= bit;
            bit >>= 1;
        }

        j ^= bit;

        if (i < j)
        {
            double complex temp = a[i];
            a[i] = a[j];
            a[j] = temp;
        }
    }

    for (len = 2; len <= n; len <<= 1)
    {
        double angle = 2 * PI / len *
                       (invert ? -1 : 1);

        double complex wlen =
            cos(angle) + I * sin(angle);

        for (i = 0; i < n; i += len)
        {
            double complex w = 1;

            for (j = 0; j < len / 2; j++)
            {
                double complex u = a[i + j];

                double complex v =
                    a[i + j + len / 2] * w;

                a[i + j] = u + v;

                a[i + j + len / 2] = u - v;

                w *= wlen;
            }
        }
    }

    if (invert)
    {
        for (i = 0; i < n; i++)
            a[i] /= n;
    }
}

int nextPowerOfTwo(int n)
{
    int p = 1;

    while (p < n)
        p <<= 1;

    return p;
}

int main()
{
    int m, n;
    int size;
    int i;

    double complex *A;
    double complex *B;

    printf("Enter length of vector A (m): ");
    scanf("%d", &m);

    printf("Enter length of vector B (n): ");
    scanf("%d", &n);

    if (n < m)
    {
        printf("Error: n must be greater than or equal to m.\n");
        return 0;
    }

       Linear convolution has length:
       m + n - 1

    size = nextPowerOfTwo(m + n - 1);

    A = (double complex *)
        calloc(size, sizeof(double complex));

    B = (double complex *)
        calloc(size, sizeof(double complex));

    printf("\nEnter elements of A:\n");

    for (i = 0; i < m; i++)
    {
        double value;
        scanf("%lf", &value);
        A[i] = value;
    }

    printf("\nEnter elements of B:\n");

    for (i = 0; i < n; i++)
    {
        double value;
        scanf("%lf", &value);
        B[i] = value;
    }

    fft(A, size, 0);
    fft(B, size, 0);

    for (i = 0; i < size; i++)
        A[i] = A[i] * B[i];

    fft(A, size, 1);

    printf("\nConvolution Result:\n");

    for (i = 0; i < m + n - 1; i++)
    {
        printf("C[%d] = %.2f\n",
               i, creal(A[i]));
    }

    free(A);
    free(B);

    return 0;
}
