#include <stdio.h>
#include <math.h>

#define MAX 1000

int findMaximum(int arr[], int n)
{
    int max = arr[0];
    int i;

    for (i = 1; i < n; i++)
    {
        if (arr[i] > max)
            max = arr[i];
    }

    return max;
}

void findLargestTwo(int arr[], int n)
{
    int largest, secondLargest;
    int i;

    if (arr[0] > arr[1])
    {
        largest = arr[0];
        secondLargest = arr[1];
    }
    else
    {
        largest = arr[1];
        secondLargest = arr[0];
    }

    for (i = 2; i < n; i++)
    {
        if (arr[i] > largest)
        {
            secondLargest = largest;
            largest = arr[i];
        }
        else if (arr[i] > secondLargest && arr[i] != largest)
        {
            secondLargest = arr[i];
        }
    }

    printf("Largest element = %d\n", largest);
    printf("Second largest element = %d\n", secondLargest);
}

// Function to find mean
double findMean(int arr[], int n)
{
    long long sum = 0;
    int i;

    for (i = 0; i < n; i++)
    {
        sum += arr[i];
    }

    return (double)sum / n;
}

// Function to sort array
void sortArray(int arr[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

// Function to find median
double findMedian(int arr[], int n)
{
    int temp[MAX];
    int i;

    // Copy original array
    for (i = 0; i < n; i++)
    {
        temp[i] = arr[i];
    }

    // Sort copied array
    sortArray(temp, n);

    if (n % 2 == 0)
    {
        return (temp[n / 2 - 1] + temp[n / 2]) / 2.0;
    }
    else
    {
        return temp[n / 2];
    }
}

double findStandardDeviation(int arr[], int n)
{
    double mean;
    double sum = 0;
    double variance;
    int i;

    mean = findMean(arr, n);

    for (i = 0; i < n; i++)
    {
        sum += (arr[i] - mean) * (arr[i] - mean);
    }

    variance = sum / n;

    return sqrt(variance);
}

// Function to find mode
void findMode(int arr[], int n)
{
    int maxCount = 0;
    int mode = arr[0];
    int i, j, count;

    for (i = 0; i < n; i++)
    {
        count = 0;

        for (j = 0; j < n; j++)
        {
            if (arr[i] == arr[j])
                count++;
        }

        if (count > maxCount)
        {
            maxCount = count;
            mode = arr[i];
        }
    }

    if (maxCount == 1)
    {
        printf("Mode = No mode\n");
    }
    else
    {
        printf("Mode = %d\n", mode);
        printf("Frequency = %d\n", maxCount);
    }
}

int removeDuplicates(int arr[], int n)
{
    int i, j, k;

    for (i = 0; i < n; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (arr[i] == arr[j])
            {
                // Shift elements to the left
                for (k = j; k < n - 1; k++)
                {
                    arr[k] = arr[k + 1];
                }

                n--;
                j--;
            }
        }
    }

    return n;
}

// Function to reverse array
void reverseArray(int arr[], int n)
{
    int i, temp;

    for (i = 0; i < n / 2; i++)
    {
        temp = arr[i];
        arr[i] = arr[n - i - 1];
        arr[n - i - 1] = temp;
    }
}

// Function to partition array with respect to pivot
void partitionArray(int arr[], int n, int pivot)
{
    int i, j, temp;

    j = 0;

    /*
       Elements greater than or equal to pivot
       are placed before elements smaller than pivot.
    */

    for (i = 0; i < n; i++)
    {
        if (arr[i] >= pivot)
        {
            temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;

            j++;
        }
    }
}

// Function to display array
void displayArray(int arr[], int n)
{
    int i;

    for (i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    printf("\n");
}

int main()
{
    int arr[MAX];
    int n, i;
    int pivot;
    int newSize;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX)
    {
        printf("Invalid number of elements.\n");
        return 0;
    }

    printf("Enter %d unsorted elements:\n", n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("\nOriginal Array:\n");
    displayArray(arr, n);

    // (i) Maximum
    printf("\n(i) Maximum element = %d\n", findMaximum(arr, n));

    // (ii) First and second largest
    printf("\n(ii) First and Second Largest:\n");
    findLargestTwo(arr, n);

    // (iii) Mean
    printf("\n(iii) Mean = %.2f\n", findMean(arr, n));

    // (iv) Median
    printf("\n(iv) Median = %.2f\n", findMedian(arr, n));

    // (v) Standard deviation
    printf("\n(v) Standard Deviation = %.2f\n",
           findStandardDeviation(arr, n));

    // (vi) Mode
    printf("\n(vi) Mode:\n");
    findMode(arr, n);

    // (vii) Remove duplicates
    newSize = removeDuplicates(arr, n);

    printf("\n(vii) Array after removing duplicates:\n");
    displayArray(arr, newSize);

    // (viii) Reverse
    reverseArray(arr, newSize);

    printf("\n(viii) Reversed Array:\n");
    displayArray(arr, newSize);

    // (ix) Partition
    printf("\n(ix) Enter pivot element: ");
    scanf("%d", &pivot);

    partitionArray(arr, newSize, pivot);

    printf("Array after partitioning:\n");
    displayArray(arr, newSize);

    return 0;
}
