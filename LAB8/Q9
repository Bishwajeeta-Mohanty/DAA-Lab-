#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

typedef unsigned long long ull;

typedef struct
{
    ull *values;
    size_t size;
    size_t capacity;
    int overflow;
} Trajectory;

int nextCollatz(ull n, ull *next)
{
    if (n == 0)
        return 0;

    if (n % 2 == 0)
    {
        *next = n / 2;
        return 1;
    }

    if (n > (ULLONG_MAX - 1) / 3)
    {
        return 0;
    }

    *next = 3 * n + 1;

    return 1;
}

void initializeTrajectory(Trajectory *t)
{
    t->capacity = 16;
    t->size = 0;
    t->overflow = 0;

    t->values = malloc(t->capacity * sizeof(ull));

    if (t->values == NULL)
    {
        printf("Memory allocation failed.\n");
        exit(EXIT_FAILURE);
    }
}

void addValue(Trajectory *t, ull value)
{
    if (t->size == t->capacity)
    {
        t->capacity *= 2;

        ull *temp = realloc(
            t->values,
            t->capacity * sizeof(ull)
        );

        if (temp == NULL)
        {
            free(t->values);
            printf("Memory reallocation failed.\n");
            exit(EXIT_FAILURE);
        }

        t->values = temp;
    }

    t->values[t->size] = value;
    t->size++;
}

void generateTrajectory(ull start, Trajectory *t)
{
    ull current = start;

    addValue(t, current);

    while (current != 1)
    {
        ull next;

        if (!nextCollatz(current, &next))
        {
            t->overflow = 1;
            return;
        }

        current = next;

        addValue(t, current);
    }
}

void printTrajectory(const Trajectory *t)
{
    printf("\nTrajectory:\n");

    for (size_t i = 0; i < t->size; i++)
    {
        printf("%llu", t->values[i]);

        if (i < t->size - 1)
            printf(" -> ");
    }

    printf("\n");
}

ull findMaximum(const Trajectory *t)
{
    ull maximum = t->values[0];

    for (size_t i = 1; i < t->size; i++)
    {
        if (t->values[i] > maximum)
            maximum = t->values[i];
    }

    return maximum;
}

void freeTrajectory(Trajectory *t)
{
    free(t->values);

    t->values = NULL;
    t->size = 0;
    t->capacity = 0;
}

void analyzeSingle(ull start)
{
    Trajectory t;

    initializeTrajectory(&t);

    generateTrajectory(start, &t);

    printf("\nStarting value = %llu\n", start);

    printTrajectory(&t);

    if (t.overflow)
    {
        printf("Overflow detected before the next value could be calculated.\n");
    }
    else
    {
        printf("Number of steps = %zu\n", t.size - 1);
        printf("Maximum value reached = %llu\n",
               findMaximum(&t));
    }

    freeTrajectory(&t);
}

void analyzeRange(ull a, ull b)
{
    ull maxStepsStart = a;
    ull maxPeakStart = a;

    size_t maxSteps = 0;
    ull maxPeak = 0;

    printf("\nRange Analysis [%llu, %llu]\n", a, b);

    for (ull start = a; start <= b; start++)
    {
        Trajectory t;

        initializeTrajectory(&t);

        generateTrajectory(start, &t);

        if (t.overflow)
        {
            printf("Start %llu: Overflow detected.\n", start);
        }
        else
        {
            size_t steps = t.size - 1;
            ull peak = findMaximum(&t);

            printf("Start = %llu, Steps = %zu, Peak = %llu\n",
                   start, steps, peak);

            if (steps > maxSteps)
            {
                maxSteps = steps;
                maxStepsStart = start;
            }

            if (peak > maxPeak)
            {
                maxPeak = peak;
                maxPeakStart = start;
            }
        }

        freeTrajectory(&t);

        if (start == ULLONG_MAX)
            break;
    }

    printf("\nRange Summary\n");

    printf("Starting value with maximum steps = %llu\n",
           maxStepsStart);

    printf("Maximum number of steps = %zu\n",
           maxSteps);

    printf("Starting value with largest peak = %llu\n",
           maxPeakStart);

    printf("Largest peak value = %llu\n",
           maxPeak);
}

int main()
{
    int choice;

    printf("=====================================\n");
    printf("       COLLATZ TRAJECTORY ANALYZER\n");
    printf("=====================================\n");

    printf("\n1. Analyze a single starting value\n");
    printf("2. Analyze an interval [a,b]\n");
    printf("Enter your choice: ");

    scanf("%d", &choice);

    if (choice == 1)
    {
        ull n;

        printf("Enter a positive integer n: ");
        scanf("%llu", &n);

        if (n == 0)
        {
            printf("Please enter a positive integer.\n");
            return 1;
        }

        analyzeSingle(n);
    }
    else if (choice == 2)
    {
        ull a, b;

        printf("Enter interval [a,b]: ");
        scanf("%llu %llu", &a, &b);

        if (a == 0 || b == 0 || a > b)
        {
            printf("Invalid interval.\n");
            return 1;
        }

        analyzeRange(a, b);
    }
    else
    {
        printf("Invalid choice.\n");
    }

    return 0;
}
