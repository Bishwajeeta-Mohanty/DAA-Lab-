#include <stdio.h>

#define MAX 100

int main()
{
    int n;
    int price[MAX + 1];
    int dp[MAX + 1];
    int firstCut[MAX + 1];

    printf("Enter length of rod: ");
    scanf("%d", &n);

    printf("Enter prices for pieces of length 1 to %d:\n", n);

    for (int i = 1; i <= n; i++)
    {
        scanf("%d", &price[i]);
    }

    dp[0] = 0;
    firstCut[0] = 0;

    for (int i = 1; i <= n; i++)
    {
        dp[i] = 0;

        for (int j = 1; j <= i; j++)
        {
            if (price[j] + dp[i - j] > dp[i])
            {
                dp[i] = price[j] + dp[i - j];

                // Store the first piece selected
                firstCut[i] = j;
            }
        }
    }

    printf("\nMaximum Revenue = %d\n", dp[n]);

    printf("Optimal pieces: ");

    int length = n;

    while (length > 0)
    {
        printf("%d ", firstCut[length]);
        length = length - firstCut[length];
    }

    printf("\n");

    return 0;
}
