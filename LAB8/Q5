#include <stdio.h>

#define MAX 100

int main()
{
    int A[MAX], dp[MAX];
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements:\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &A[i]);

        dp[i] = A[i];
    }

    for (int i = 1; i < n; i++)
    {
        for (int j = 0; j < i; j++)
        {
            if (A[j] < A[i])
            {
                if (dp[j] + A[i] > dp[i])
                {
                    dp[i] = dp[j] + A[i];
                }
            }
        }
    }

    int maxSum = dp[0];

    for (int i = 1; i < n; i++)
    {
        if (dp[i] > maxSum)
        {
            maxSum = dp[i];
        }
    }

    printf("\nMaximum Sum Increasing Subsequence = %d\n", maxSum);

    return 0;
}
